# --- Claude (brain) ---
# Required once you move past the placeholder agent reply.
ANTHROPIC_API_KEY=sk-ant-...
OBK_AGENT_MODEL=claude-sonnet-4-6

# --- Server ---
OBK_HOST=0.0.0.0
OBK_PORT=8000
# WebSocket path the K10 firmware connects to (must match firmware config).
OBK_WS_PATH=/xiaozhi/v1
# Bearer token the firmware sends in the Authorization header.
# Leave blank to disable auth (fine for a trusted LAN desk device).
OBK_AUTH_TOKEN=

# --- Voice providers ---
# Phase 0: fake (echo)  |  Phase 1: sensevoice / edge  |  Phase 2: elevenlabs
OBK_STT_PROVIDER=fake
OBK_TTS_PROVIDER=fake

# ElevenLabs (only if a provider above is set to elevenlabs)
ELEVENLABS_API_KEY=
OBK_ELEVENLABS_VOICE_ID=

# --- Audio ---
# Uplink (device -> server) per xiaozhi defaults; downlink is what we send back.
OBK_UPLINK_SAMPLE_RATE=16000
OBK_DOWNLINK_SAMPLE_RATE=16000
OBK_OPUS_FRAME_MS=60
